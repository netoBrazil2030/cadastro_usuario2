@model ContatoModel;
@{
    ViewData["Title"] = "Editar contato";
}

<div class="text-center">
    
    <h1 class="display-4">Editar Contato</h1>

     
</div>

<form asp-controller="Contato" asp-action="Alterar" method="post">

    <input type="hidden" asp-for="Id"/>
    <div class="mb-3">
        <label for="name">Nome</label>
        <input type="text" asp-for="Nome" class="form-control" placeholder="Digite seu nome.">
    </div>

    <div class="mb-3">
        <label for="email">E-mail</label>
        <input type="email" asp-for="Email" class="form-control" placeholder="Digite seu email.">
    </div>

    <div class="mb-3">
        <label for="fone">Celular</label>
        <input type="number" asp-for="Celular" class="form-control" placeholder="Digite seu telefone (DDD)0000-0000.">
    </div>
    <button type="submit" class="btn btn-primary w-100 mb-2">Alterar</button>
    <a type="button" class="btn btn-secondary w-100" asp-controller="Contato" asp-action="Index" role="button">Voltar</a>

</form>